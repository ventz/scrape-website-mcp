# OPTIONAL — only needed if you call this MCP server's OpenAI-side tools
# (register_url / resync_url / resync_all / unregister_url / list_registered)
# directly from an external MCP client.
#
# When this server is wired into the Harvard EA assistants platform via the
# "Scrape Website (self-hosted)" prebuilt, the platform handles all OpenAI
# uploads itself using the agent's own key. In that case the platform only
# ever calls `fetch_url_as_markdown`, which has no OpenAI dependency, and
# you can leave OPENAI_API_KEY blank.
#
# Precedence: a value here OVERRIDES the parent shell env. Leave commented
# out to fall back to shell env. Same applies to MCP_BEARER_TOKEN below.
# OPENAI_API_KEY=sk-...

# Required: bearer token that the assistants platform (or any MCP client)
# must present in the Authorization header to use this server.
# Generate with: openssl rand -hex 32
MCP_BEARER_TOKEN=changeme

# Optional: SQLite state directory (default: ./data)
STATE_DIR=./data

# Optional: pin which ref of ventz/scrape-website to use at build/setup time.
# Used by Dockerfile (build arg) and Makefile: a branch, tag, or FULL commit
# SHA. Set to "main" for HEAD. Default: 6d701c6 (0.7.3).
SCRAPE_WEBSITE_REF=6d701c69555edf71687c989f3615c93c2520d369

# Optional: User-Agent override for outbound scrapes.
SCRAPER_USER_AGENT=scrape-website-mcp/0.1

# Optional: outbound-target guard. Private, loopback, link-local (cloud
# metadata), CGNAT and reserved addresses are refused on every fetch and
# redirect hop. Set to 1 only to scrape intranet hosts on purpose.
# SCRAPER_ALLOW_PRIVATE_TARGETS=0

# Optional: let callers pass allow_insecure_tls=true (off by default).
# SCRAPER_ALLOW_INSECURE_TLS=0

# Optional: engine limits (defaults shown).
# SCRAPER_TIMEOUT=30
# SCRAPER_MAX_TIMEOUT_S=120
# SCRAPER_MAX_RETRIES=3
# SCRAPER_MAX_FILE_SIZE=52428800
# SCRAPER_MAX_PAGE_SIZE=52428800
# SCRAPER_RENDER_TIMEOUT=30
# SCRAPER_RENDER_SETTLE_MS=3000
# SCRAPER_RENDER_CONCURRENCY=4

# Optional: caps on caller-supplied values (clamped, reported in `warnings`).
# SCRAPER_MAX_CRAWL_CONCURRENCY=8
# SCRAPER_MIN_DELAY_MS=0
# SCRAPER_MAX_BATCH_URLS=100
# SCRAPER_MAX_RESPONSE_BYTES=
# SCRAPER_MAX_INLINE_HTML_BYTES=2097152
# SCRAPER_MAX_INLINE_DOC_BYTES=10485760
